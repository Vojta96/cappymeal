{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "nickname": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 32"
        },
        "householdId": {
          ".validate": "newData.isString() && newData.val().length <= 64 && root.child('households').child(newData.val()).child('members').child($uid).exists()"
        },
        "$other": { ".validate": false }
      }
    },

    "joinCodes": {
      "$code": {
        ".read": "auth != null",
        ".write": false
      }
    },

    "rohlikCredentials": { ".read": false, ".write": false },
    "rohlikOAuthClient": { ".read": false, ".write": false },
    "rohlikOAuthPending": { ".read": false, ".write": false },
    "rateLimits": { ".read": false, ".write": false },
    "householdIndex": { ".read": false, ".write": false },

    "householdPhotos": {
      "$hid": {
        ".read": "auth != null && root.child('households').child($hid).child('members').child(auth.uid).exists()",
        "$rid": {
          ".write": "auth != null && root.child('households').child($hid).child('members').child(auth.uid).exists()",
          ".validate": "newData.isString() && newData.val().beginsWith('data:image/jpeg;base64,') && newData.val().length < 400000"
        }
      }
    },

    "householdThumbs": {
      "$hid": {
        ".read": "auth != null && root.child('households').child($hid).child('members').child(auth.uid).exists()",
        "$rid": {
          ".write": "auth != null && root.child('households').child($hid).child('members').child(auth.uid).exists()",
          ".validate": "newData.isString() && newData.val().beginsWith('data:image/jpeg;base64,') && newData.val().length < 45000"
        }
      }
    },

    "households": {
      "$hid": {
        ".read": "auth != null && data.child('members').child(auth.uid).exists()",
        ".write": false,

        "owner": { ".write": false },
        "joinCode": { ".write": false },
        "members": { ".write": false },
        "rohlik": { ".write": false },
        "createdAt": { ".write": false },

        "name": {
          ".write": "auth != null && data.parent().child('owner').val() === auth.uid",
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
        },

        "recipes": {
          "$rid": {
            ".write": "auth != null && root.child('households').child($hid).child('members').child(auth.uid).exists()",
            ".validate": "newData.hasChildren(['name', 'type'])",
            "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 80" },
            "type": { ".validate": "newData.isString() && (newData.val() === 'breakfast' || newData.val() === 'snack' || newData.val() === 'lunch' || newData.val() === 'afternoon_snack' || newData.val() === 'dinner' || newData.val() === 'treat')" },
            "types": {
              "$slot": { ".validate": "($slot === 'breakfast' || $slot === 'snack' || $slot === 'lunch' || $slot === 'afternoon_snack' || $slot === 'dinner' || $slot === 'treat') && newData.val() === true" }
            },
            "emoji": { ".validate": "newData.isString() && newData.val().length <= 16" },
            "preparation": { ".validate": "newData.isString() && newData.val().length <= 80" },
            "instructions": { ".validate": "newData.isString() && newData.val().length <= 5000" },
            "builtinImage": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "hasPhoto": { ".validate": "newData.isBoolean()" },
            "createdBy": { ".validate": "newData.isString() && newData.val().length <= 128" },
            "updatedAt": { ".validate": "newData.isNumber()" },
            "ingredients": {
              "$i": {
                ".validate": "$i.matches(/^([0-9]|[1-5][0-9])$/) && newData.hasChildren(['name'])",
                "name": { ".validate": "newData.isString() && newData.val().length <= 80" },
                "amount": { ".validate": "newData.isString() && newData.val().length <= 40" },
                "$other": { ".validate": false }
              }
            },
            "$other": { ".validate": false }
          }
        },

        "photos": {
          "$rid": {
            ".write": "auth != null && !newData.exists() && root.child('households').child($hid).child('members').child(auth.uid).exists()"
          }
        },

        "plan": {
          "$date": {
            ".write": "auth != null && root.child('households').child($hid).child('members').child(auth.uid).exists()",
            ".validate": "$date.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",
            "$slot": {
              ".validate": "($slot === 'breakfast' || $slot === 'snack' || $slot === 'lunch' || $slot === 'afternoon_snack' || $slot === 'dinner' || $slot === 'treat') && newData.isString() && newData.val().length <= 40"
            }
          }
        },

        "memberMeals": {
          "$date": {
            ".write": "auth != null && root.child('households').child($hid).child('members').child(auth.uid).exists()",
            ".validate": "$date.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",
            "$slot": {
              ".validate": "$slot === 'breakfast' || $slot === 'snack' || $slot === 'lunch' || $slot === 'afternoon_snack' || $slot === 'dinner' || $slot === 'treat'",
              "$uid": {
                ".validate": "root.child('households').child($hid).child('members').child($uid).exists() && newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
              }
            }
          }
        },

        "weekTemplate": {
          ".write": "auth != null && root.child('households').child($hid).child('members').child(auth.uid).exists()",
          "from": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)" },
          "by": { ".validate": "newData.val() === auth.uid" },
          "at": { ".validate": "newData.isNumber()" },
          "days": {
            "$day": {
              ".validate": "$day.matches(/^d[0-6]$/)",
              "plan": {
                "$slot": {
                  ".validate": "($slot === 'breakfast' || $slot === 'snack' || $slot === 'lunch' || $slot === 'afternoon_snack' || $slot === 'dinner' || $slot === 'treat') && newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
                }
              },
              "members": {
                "$slot": {
                  ".validate": "$slot === 'breakfast' || $slot === 'snack' || $slot === 'lunch' || $slot === 'afternoon_snack' || $slot === 'dinner' || $slot === 'treat'",
                  "$uid": {
                    ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
                  }
                }
              },
              "$other": { ".validate": false }
            }
          },
          "$other": { ".validate": false }
        },

        "orders": {
          "$date": {
            ".write": "auth != null && root.child('households').child($hid).child('members').child(auth.uid).exists()",
            ".validate": "$date.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && newData.hasChildren(['status', 'at', 'by'])",
            "status": { ".validate": "newData.isString() && (newData.val() === 'in_cart' || newData.val() === 'ordered')" },
            "at": { ".validate": "newData.isNumber()" },
            "by": { ".validate": "newData.val() === auth.uid" },
            "planChanged": { ".validate": "newData.isBoolean()" },
            "rohlikOrderId": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() % 1 === 0" },
            "$other": { ".validate": false }
          }
        },

        "regulars": {
          "$id": {
            ".write": "auth != null && root.child('households').child($hid).child('members').child(auth.uid).exists()",
            ".validate": "newData.hasChildren(['name']) && $id.length <= 40",
            "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 80" },
            "amount": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "auto": { ".validate": "newData.isBoolean()" },
            "createdBy": { ".validate": "newData.isString() && newData.val().length <= 128" },
            "createdAt": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },

        "pantry": {
          "$key": {
            ".write": "auth != null && root.child('households').child($hid).child('members').child(auth.uid).exists()",
            ".validate": "newData.isBoolean() && $key.length <= 100"
          }
        },

        "settings": {
          ".write": "auth != null && root.child('households').child($hid).child('members').child(auth.uid).exists()",
          "remind3d": { ".validate": "newData.isBoolean()" },
          "remindDaily": { ".validate": "newData.isBoolean()" },
          "remindBoth": { ".validate": "newData.isBoolean()" },
          "remindHour": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 23 && newData.val() % 1 === 0" },
          "shop": {
            "preferLight": { ".validate": "newData.isBoolean()" },
            "preferBio": { ".validate": "newData.isBoolean()" },
            "sort": { ".validate": "newData.isString() && (newData.val() === 'best' || newData.val() === 'unitPrice')" },
            "$other": { ".validate": false }
          },
          "delivery": {
            "addressId": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 999999999999999 && newData.val() % 1 === 0" },
            "addressLabel": { ".validate": "newData.isString() && newData.val().length <= 80" },
            "window": { ".validate": "newData.isString() && (newData.val() === 'morning' || newData.val() === 'afternoon' || newData.val() === 'evening' || newData.val() === 'any')" },
            "lead": { ".validate": "newData.isString() && (newData.val() === 'dayBefore' || newData.val() === 'sameDay')" },
            "paymentId": { ".validate": "newData.isString() && newData.val().matches(/^[A-Z0-9_]{1,40}$/)" },
            "paymentLabel": { ".validate": "newData.isString() && newData.val().length <= 60" },
            "courierNote": { ".validate": "newData.isString() && newData.val().length <= 300" },
            "packaging": { ".validate": "newData.isString() && (newData.val() === 'PAPER_BAGS' || newData.val() === 'REUSABLE_BAGS')" },
            "$other": { ".validate": false }
          },
          "$other": { ".validate": false }
        },

        "productPrefs": {
          "$key": {
            ".write": "auth != null && root.child('households').child($hid).child('members').child(auth.uid).exists()",
            ".validate": "$key.length <= 120 && newData.hasChildren(['productId', 'name', 'count', 'lastAt', 'by'])",
            "productId": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40" },
            "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 200" },
            "imageUrl": { ".validate": "newData.isString() && newData.val().length <= 500 && newData.val().beginsWith('https://')" },
            "priceText": { ".validate": "newData.isString() && newData.val().length <= 200" },
            "packText": { ".validate": "newData.isString() && newData.val().length <= 200" },
            "count": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 1000000 && newData.val() % 1 === 0" },
            "lastAt": { ".validate": "newData.isNumber()" },
            "by": { ".validate": "newData.val() === auth.uid" },
            "$other": { ".validate": false }
          }
        },

        "activity": {
          "$aid": {
            ".write": "auth != null && !data.exists() && root.child('households').child($hid).child('members').child(auth.uid).exists()",
            ".validate": "newData.hasChildren(['text', 'type', 'by', 'at'])",
            "text": { ".validate": "newData.isString() && newData.val().length <= 200" },
            "type": { ".validate": "newData.isString() && (newData.val() === 'plan' || newData.val() === 'recipe' || newData.val() === 'order')" },
            "by": { ".validate": "newData.val() === auth.uid" },
            "at": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },

        "pushTokens": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('households').child($hid).child('members').child(auth.uid).exists()",
            "$tid": {
              ".validate": "newData.hasChildren(['token']) && $tid.length <= 64",
              "token": { ".validate": "newData.isString() && newData.val().length <= 4096" },
              "createdAt": { ".validate": "newData.isNumber()" },
              "ua": { ".validate": "newData.isString() && newData.val().length <= 200" },
              "$other": { ".validate": false }
            }
          }
        },

        "$other": { ".write": false }
      }
    }
  }
}
